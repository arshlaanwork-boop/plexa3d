{
  "entities": {
    "Inquiry": {
      "title": "Inquiry",
      "description": "Customer inquiry and lucky draw record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "packageId": { "type": "string" },
        "packageName": { "type": "string" },
        "businessName": { "type": "string" },
        "phone": { "type": "string" },
        "goals": { "type": "string" },
        "luckyDiscount": { "type": "number" },
        "finalPrice": { "type": "number" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["userId", "packageId", "packageName", "businessName", "phone", "goals", "createdAt"]
    }
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": {
        "$ref": "#/entities/Inquiry"
      },
      "description": "Collection of client inquiries."
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inquiries/{inquiryId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }
    match /creator_applications/{appId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }
  }
}
